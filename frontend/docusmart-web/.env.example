# DocuSmart Web — variáveis de ambiente
# Copie para .env.local e preencha quando o backend AWS existir.
#
# IMPORTANTE: hoje o app roda 100% em mock (lib/docusmart/mock-api.ts) e NÃO lê
# nenhuma destas variáveis. Elas ficam aqui prontas para quando a API real entrar.

# Base URL da API REST (API Gateway). Ex.: https://abc123.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_API_BASE_URL=

# Endpoints esperados (definidos pelo time de API/Orquestração):
#   POST   /upload-sinistro      -> intake do pacote (gera numero_sinistro)
#   GET    /sinistro/{id}        -> dados consolidados de um sinistro
#   GET    /sinistros            -> lista para o painel
#   POST   /assistente/pergunta  -> agente SAC
#   DELETE /sinistro/{id}        -> remoção (LGPD)

# DocuSmart Web — variáveis de ambiente
# Copie para .env.local e ajuste conforme necessário.

# Base URL da API REST (API Gateway).
# Se não definida, o app usa o endpoint atual como fallback (ver lib/docusmart/api.ts).
NEXT_PUBLIC_API_BASE_URL=https://8ntra04xyh.execute-api.us-east-1.amazonaws.com/prod

# Status dos endpoints:
#   POST /upload                 -> presigned URL p/ S3        ✅ EM USO (upload real)
#
# Ainda no mock (lib/docusmart/mock-api.ts), aguardando backend:
#   POST   ?  intake             -> criar sinistro / numero_sinistro
#   GET    ?  /sinistro/{id}     -> dados consolidados
#   GET    ?  /sinistros         -> lista do painel
#   POST   ?  /assistente        -> agente SAC
#   DELETE ?  /sinistro/{id}     -> remoção (LGPD)

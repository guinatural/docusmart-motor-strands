# Variáveis de ambiente da Lambda — Motor Strands
# Copie este arquivo para .env e preencha os valores

# Região AWS onde os recursos estão criados
AWS_REGION_NAME=us-east-1

# Nome da tabela DynamoDB para resultados e auditoria
DYNAMO_TABLE_NAME=sinistros-resultados

# Nome do bucket S3 com os documentos
DOCUMENTS_BUCKET=docusmart-sinistros
